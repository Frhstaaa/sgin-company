<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prioritize Laravel public index.php
    DirectoryIndex public/index.php index.php

    # 1. Block access to sensitive files and directories
    RewriteRule ^\.(env|git|editorconfig|gitignore|gitattributes) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/(.*) - [F,L,NC]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js) - [F,L,NC]

    # 2. Redirect all traffic to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

